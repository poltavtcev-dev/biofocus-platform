{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BioFocus",
  "version": "0.1.0",
  "identifier": "com.biofocus.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "BioFocus",
        "width": 320,
        "height": 460,
        "resizable": false,
        "maximizable": false,
        "fullscreen": false
      },
      {
        "label": "dashboard",
        "title": "BioFocus — Dashboard",
        "url": "index.html?view=dashboard",
        "width": 720,
        "height": 520,
        "minWidth": 480,
        "minHeight": 360,
        "resizable": true,
        "visible": false,
        "maximizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
